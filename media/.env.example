# User/Group IDs
PUID=501
PGID=20

# Timezone
TZ=Asia/Ho_Chi_Minh

# Paths (configs only - media/download paths hardcoded in compose for dual-drive setup)
DATA_PATH=/Volumes/Blue4/arr/data

# VPN (https://github.com/qdm12/gluetun-wiki/tree/main/setup/providers)
VPN_SERVICE_PROVIDER=
OPENVPN_USER=
OPENVPN_PASSWORD=
# Optional: comma-separated list of regions (omit for auto)
SERVER_REGIONS=
# Port forwarding for better torrent connectivity (on/off)
VPN_PORT_FORWARDING=on

# MyAnonaMouse (optional - set MAM_ID and add "mam" to COMPOSE_PROFILES to enable)
# Get your session ID from MAM security preferences (dynamic seedbox session)
MAM_ID=
COMPOSE_PROFILES=
