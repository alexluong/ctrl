   "link": null,
   "locked": false,
   "text": "SoLex \u2014 domain model v1",
   "fontSize": 32,
   "fontFamily": 1,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "SoLex \u2014 domain model v1",
