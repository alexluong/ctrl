  },
  {
   "id": "text351_92148",
   "type": "text",
   "x": 76,
   "y": 2922.0,
   "width": 368.28,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1164652845,
   "version": 1,
   "versionNonce": 1760029988,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790175363079,
   "link": null,
   "locked": false,
   "text": "id, hotelId\nowner: { stay } (own)  |  { booking } (master)\nstatus: open | closed\nbalance = sum(charges) - voided - payments + refunds\n\nCharge { stayId, businessDate, categoryId, itemId?,\n  description, qty, unitPrice, voided? }\nPayment { businessDate, method: cash | bankTransfer\n  | card (word only, no card data), kind: deposit |\n  settlement | refund, amount, ref? }\n\none own folio per Stay + one master per group Booking;\ncharge posted against a stay, routed by category",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "id, hotelId\nowner: { stay } (own)  |  { booking } (master)\nstatus: open | closed\nbalance = sum(charges) - voided - payments + refunds\n\nCharge { stayId, businessDate, categoryId, itemId?,\n  description, qty, unitPrice, voided? }\nPayment { businessDate, method: cash | bankTransfer\n  | card (word only, no card data), kind: deposit |\n  settlement | refund, amount, ref? }\n\none own folio per Stay + one master per group Booking;\ncharge posted against a stay, routed by category",
   "lineHeight": 1.25,
   "autoResize": true
  },
