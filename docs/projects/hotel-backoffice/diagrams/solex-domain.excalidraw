  {
   "id": "text69_47621",
   "type": "text",
   "x": 76,
   "y": 1129.75,
   "width": 409.2,
   "height": 192.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
