  {
   "id": "text71_32377",
   "type": "text",
   "x": 860,
   "y": 994,
   "width": 369.59999999999997,
   "height": 206.25,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1720926263,
   "version": 1,
   "versionNonce": 973838694,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1790171010801,
   "link": null,
   "locked": false,
   "text": "Account { id, hotelId, kind: folio | receivable | cash |\n  bank | revenue | expense, ref?, status }\nEntry { id, hotelId, businessDate, kind: charge |\n  payment | refund | transfer | expense | reversal,\n  lines[]: { accountId, amount }  \u03a3 = 0,\n  ref?, memo? }\nentries immutable \u00b7 undo = reversal \u00b7 close at 0\n\ncharge     debit folio / credit revenue:category\npayment    debit cash|bank / credit folio\ntransfer   debit receivable:company / credit folio\nexpense    debit expense:category / credit cash|bank\n\nevents: ledger.account_opened \u00b7 entry_posted \u00b7\nentry_reversed \u00b7 account_closed",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Account { id, hotelId, kind: folio | receivable | cash |\n  bank | revenue | expense, ref?, status }\nEntry { id, hotelId, businessDate, kind: charge |\n  payment | refund | transfer | expense | reversal,\n  lines[]: { accountId, amount }  \u03a3 = 0,\n  ref?, memo? }\nentries immutable \u00b7 undo = reversal \u00b7 close at 0\n\ncharge     debit folio / credit revenue:category\npayment    debit cash|bank / credit folio\ntransfer   debit receivable:company / credit folio\nexpense    debit expense:category / credit cash|bank\n\nevents: ledger.account_opened \u00b7 entry_posted \u00b7\nentry_reversed \u00b7 account_closed",
   "lineHeight": 1.25,
   "autoResize": true
  },
