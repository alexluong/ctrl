  {
   "id": "text228_46044",
   "type": "text",
   "x": 76,
   "y": 2755.875,
   "width": 368.28,
   "height": 178.75,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
