   "boundElements": null,
   "updated": 1790175363079,
   "link": null,
   "locked": false,
   "text": "id, hotelId, businessDate\nkind: charge | payment | refund | transfer | expense | reversal\nlines[]: { accountId, amount }    + debit, - credit, sum = 0\nref? { stayId?, chargeId?, entryId? }, memo?\nimmutable \u00b7 undo = reversal entry\n\ncharge    debit folio            / credit revenue:category\npayment   debit cash|bank        / credit folio\nrefund    debit folio            / credit cash|bank\ntransfer  debit receivable:co    / credit folio\nreceivable paid  debit cash|bank / credit receivable:co\nexpense   debit expense:category / credit cash|bank\nvoid      reversal",
   "fontSize": 11,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "id, hotelId, businessDate\nkind: charge | payment | refund | transfer | expense | reversal\nlines[]: { accountId, amount }    + debit, - credit, sum = 0\nref? { stayId?, chargeId?, entryId? }, memo?\nimmutable \u00b7 undo = reversal entry\n\ncharge    debit folio            / credit revenue:category\npayment   debit cash|bank        / credit folio\nrefund    debit folio            / credit cash|bank\ntransfer  debit receivable:co    / credit folio\nreceivable paid  debit cash|bank / credit receivable:co\nexpense   debit expense:category / credit cash|bank\nvoid      reversal",
   "lineHeight": 1.25,
   "autoResize": true
  },
  {
   "id": "text493_60022",
